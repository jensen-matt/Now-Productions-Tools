{
  "name": "lower-third-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Generates the ServiceNow-brand lower-third name/title graphic as a ProRes 4444 RGBA video from a name and title.",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "render": "node scripts/render.mjs",
    "app:build": "vite build --config app/vite.config.ts",
    "graphics:build": "vite build --config graphics-app/vite.config.ts",
    "teleprompter:build": "vite build --config teleprompter-app/vite.config.ts",
    "app": "npm run app:build && npm run graphics:build && npm run teleprompter:build && node app/server.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/google-fonts": "4.0.290",
    "@remotion/player": "4.0.290",
    "@remotion/renderer": "4.0.290",
    "express": "4.21.1",
    "mammoth": "1.8.0",
    "multer": "2.2.0",
    "pdf-parse": "1.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290",
    "zod": "3.22.3"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "prettier": "3.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
